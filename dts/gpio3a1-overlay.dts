// SPDX-License-Identifier: GPL-2.0
/*
 * gpio3a1-overlay.dts - device tree overlay for GPIO3_A1 (TaishanPi RK3566)
 *
 * This overlay is compiled standalone into gpio3a1.dtbo.  It references
 * nodes of the SDK base device tree by label:
 *
 *   &gpio3   - GPIO bank 3 controller (rk356x.dtsi)
 *   &pinctrl - SoC pin controller       (rk356x.dtsi)
 *
 * The labels are resolved at overlay-apply time from the base FDT's
 * __symbols__ table (the SDK builds the board DTB with CONFIG_DTC_SYMBOLS=y),
 * so no SDK source file has to be touched.
 *
 * Deploy: copy gpio3a1.dtbo to /boot/overlays/ on the board, add
 * "overlays=gpio3a1.dtbo" to /boot/ubootEnv.txt, reboot.  The Rockchip
 * U-Boot (CONFIG_OF_LIBFDT_OVERLAY) merges it into the live FDT before
 * handing it to the kernel.
 *
 * GPIO3_A1: bank 3, group A, pin 1 -> linux gpio number 97, RK_PA1.
 *
 * Note: Rockchip pinctrl parses groups as children of a function node
 * (/pinctrl/<function>/<group>), so the group must stay nested.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			gpio3a1: gpio3a1 {
				compatible = "work,gpio3a1";
				status = "okay";
				gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
				pinctrl-names = "default";
				pinctrl-0 = <&gpio3a1_pin>;
			};
		};
	};

	fragment@1 {
		target = <&pinctrl>;
		__overlay__ {
			gpio3a1 {
				gpio3a1_pin: gpio3a1-pin {
					rockchip,pins =
						<3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
				};
			};
		};
	};
};
